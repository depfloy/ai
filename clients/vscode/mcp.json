{
  "servers": {
    "depfloy": {
      "type": "http",
      "url": "https://app.depfloy.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:depfloy-token}"
      }
    }
  },
  "inputs": [
    {
      "id": "depfloy-token",
      "type": "promptString",
      "description": "Depfloy API token — Settings → API Tokens",
      "password": true
    }
  ]
}
